/* Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
 * Palette hornero-signal-night (dark). Redefines the named colours the Hornero Signal GTK theme reads. */
@define-color hs_ground #0C1016;
@define-color hs_sunken #10151C;
@define-color hs_base #141B24;
@define-color hs_panel #1B2430;
@define-color hs_raised #24303D;
@define-color hs_lifted #2C3947;
@define-color hs_ink #E6EBF1;
@define-color hs_ink_muted #A9B7C6;
@define-color hs_ink_faint #8999AB;
@define-color hs_rule #2D3B4B;
@define-color hs_rule_strong #8393A6;
@define-color hs_signal #F2AC52;
@define-color hs_on_signal #1E1304;
@define-color hs_signal_well #3D2B12;
@define-color hs_on_signal_well #FFE0B0;
@define-color hs_cue #8BCEF0;
@define-color hs_on_cue #071A26;
@define-color hs_cue_well #163345;
@define-color hs_on_cue_well #D6EFFC;
@define-color hs_phosphor #8DDBAF;
@define-color hs_on_phosphor #071D12;
@define-color hs_phosphor_well #153425;
@define-color hs_on_phosphor_well #D1F5E0;
@define-color hs_alert #FF8494;
@define-color hs_on_alert #24070C;
@define-color hs_alert_well #421922;
@define-color hs_on_alert_well #FFD6DC;
@define-color hs_inverse #E6EBF1;
@define-color hs_on_inverse #1B2430;
@define-color hs_inverse_signal #864700;
@define-color hs_scrim #000000;
@define-color hs_shadow #000000;
@define-color hs_focus #8BCEF0;
@define-color hs_glow #FFC06B;
@define-color hs_signal_hover mix(@hs_signal, #FFFFFF, 0.12);
@define-color hs_signal_active mix(@hs_signal, @hs_base, 0.18);
@define-color hs_alert_hover mix(@hs_alert, #FFFFFF, 0.12);
@define-color theme_bg_color #141B24;
@define-color theme_fg_color #E6EBF1;
@define-color theme_base_color #1B2430;
@define-color theme_text_color #E6EBF1;
@define-color theme_selected_bg_color #8BCEF0;
@define-color theme_selected_fg_color #071A26;
@define-color theme_tooltip_bg_color #2C3947;
@define-color theme_tooltip_fg_color #E6EBF1;
@define-color theme_unfocused_bg_color #141B24;
@define-color theme_unfocused_fg_color #A9B7C6;
@define-color theme_unfocused_base_color #1B2430;
@define-color theme_unfocused_text_color #A9B7C6;
@define-color theme_unfocused_selected_bg_color #163345;
@define-color theme_unfocused_selected_fg_color #D6EFFC;
@define-color insensitive_bg_color #1B2430;
@define-color insensitive_fg_color #8999AB;
@define-color insensitive_base_color #1B2430;
@define-color borders #8393A6;
@define-color unfocused_borders #2D3B4B;
@define-color warning_color #F2AC52;
@define-color error_color #FF8494;
@define-color success_color #8DDBAF;
