/* Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
 * Palette hornero-signal-night (dark). Redefines the named colours the Hornero Signal GTK theme reads. */
@define-color hs_ground #0C0F13;
@define-color hs_sunken #101419;
@define-color hs_base #13171D;
@define-color hs_panel #181D24;
@define-color hs_raised #1F252E;
@define-color hs_lifted #283039;
@define-color hs_ink #ECE6DA;
@define-color hs_ink_muted #A8ABAD;
@define-color hs_ink_faint #737980;
@define-color hs_rule #2C333C;
@define-color hs_rule_strong #707A85;
@define-color hs_signal #F2A33A;
@define-color hs_on_signal #1A1205;
@define-color hs_signal_well #3A2A12;
@define-color hs_on_signal_well #FFD9A3;
@define-color hs_cue #7EC1EA;
@define-color hs_on_cue #06151F;
@define-color hs_cue_well #16303F;
@define-color hs_on_cue_well #CDE8F8;
@define-color hs_phosphor #8BD49A;
@define-color hs_on_phosphor #07170C;
@define-color hs_phosphor_well #173222;
@define-color hs_on_phosphor_well #CDEFD4;
@define-color hs_alert #F0705A;
@define-color hs_on_alert #1E0905;
@define-color hs_alert_well #3D1A14;
@define-color hs_on_alert_well #FFD3CA;
@define-color hs_inverse #ECE6DA;
@define-color hs_on_inverse #181D24;
@define-color hs_inverse_signal #8A5200;
@define-color hs_scrim #000000;
@define-color hs_shadow #000000;
@define-color hs_focus #7EC1EA;
@define-color hs_glow #FFB650;
@define-color hs_signal_hover mix(@hs_signal, #FFFFFF, 0.12);
@define-color hs_signal_active mix(@hs_signal, @hs_base, 0.18);
@define-color hs_alert_hover mix(@hs_alert, #FFFFFF, 0.12);
@define-color theme_bg_color #13171D;
@define-color theme_fg_color #ECE6DA;
@define-color theme_base_color #181D24;
@define-color theme_text_color #ECE6DA;
@define-color theme_selected_bg_color #7EC1EA;
@define-color theme_selected_fg_color #06151F;
@define-color theme_tooltip_bg_color #283039;
@define-color theme_tooltip_fg_color #ECE6DA;
@define-color theme_unfocused_bg_color #13171D;
@define-color theme_unfocused_fg_color #A8ABAD;
@define-color theme_unfocused_base_color #181D24;
@define-color theme_unfocused_text_color #A8ABAD;
@define-color theme_unfocused_selected_bg_color #16303F;
@define-color theme_unfocused_selected_fg_color #CDE8F8;
@define-color insensitive_bg_color #181D24;
@define-color insensitive_fg_color #737980;
@define-color insensitive_base_color #181D24;
@define-color borders #707A85;
@define-color unfocused_borders #2C333C;
@define-color warning_color #F2A33A;
@define-color error_color #F0705A;
@define-color success_color #8BD49A;
