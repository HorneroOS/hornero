/* Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
 * Palette hornero-signal-day (light). Redefines the named colours the Hornero Signal GTK theme reads. */
@define-color hs_ground #E8EDF4;
@define-color hs_sunken #E0E6EF;
@define-color hs_base #EEF2F7;
@define-color hs_panel #F5F8FC;
@define-color hs_raised #FCFCFE;
@define-color hs_lifted #FFFFFF;
@define-color hs_ink #283344;
@define-color hs_ink_muted #505E70;
@define-color hs_ink_faint #606D80;
@define-color hs_rule #D2DAE6;
@define-color hs_rule_strong #7A8798;
@define-color hs_signal #864700;
@define-color hs_on_signal #FFFFFF;
@define-color hs_signal_well #FCE9C8;
@define-color hs_on_signal_well #432300;
@define-color hs_cue #145D86;
@define-color hs_on_cue #FFFFFF;
@define-color hs_cue_well #D8EEF9;
@define-color hs_on_cue_well #0B334B;
@define-color hs_phosphor #1E6448;
@define-color hs_on_phosphor #FFFFFF;
@define-color hs_phosphor_well #D6F4E8;
@define-color hs_on_phosphor_well #0E3425;
@define-color hs_alert #9C293E;
@define-color hs_on_alert #FFFFFF;
@define-color hs_alert_well #FADDE4;
@define-color hs_on_alert_well #4E111E;
@define-color hs_inverse #283344;
@define-color hs_on_inverse #F5F8FC;
@define-color hs_inverse_signal #F2AC52;
@define-color hs_scrim #000000;
@define-color hs_shadow #000000;
@define-color hs_focus #145D86;
@define-color hs_glow #864700;
@define-color hs_signal_hover mix(@hs_signal, #000000, 0.12);
@define-color hs_signal_active mix(@hs_signal, @hs_base, 0.18);
@define-color hs_alert_hover mix(@hs_alert, #000000, 0.12);
@define-color theme_bg_color #EEF2F7;
@define-color theme_fg_color #283344;
@define-color theme_base_color #F5F8FC;
@define-color theme_text_color #283344;
@define-color theme_selected_bg_color #145D86;
@define-color theme_selected_fg_color #FFFFFF;
@define-color theme_tooltip_bg_color #FFFFFF;
@define-color theme_tooltip_fg_color #283344;
@define-color theme_unfocused_bg_color #EEF2F7;
@define-color theme_unfocused_fg_color #505E70;
@define-color theme_unfocused_base_color #F5F8FC;
@define-color theme_unfocused_text_color #505E70;
@define-color theme_unfocused_selected_bg_color #D8EEF9;
@define-color theme_unfocused_selected_fg_color #0B334B;
@define-color insensitive_bg_color #F5F8FC;
@define-color insensitive_fg_color #606D80;
@define-color insensitive_base_color #F5F8FC;
@define-color borders #7A8798;
@define-color unfocused_borders #D2DAE6;
@define-color warning_color #864700;
@define-color error_color #9C293E;
@define-color success_color #1E6448;
