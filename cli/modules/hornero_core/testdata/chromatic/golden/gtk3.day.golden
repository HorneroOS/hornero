/* Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
 * Palette hornero-signal-day (light). Redefines the named colours the Hornero Signal GTK theme reads. */
@define-color hs_ground #E6E1D5;
@define-color hs_sunken #DCD6C8;
@define-color hs_base #F2EEE5;
@define-color hs_panel #F7F4EE;
@define-color hs_raised #FBF9F5;
@define-color hs_lifted #FFFFFF;
@define-color hs_ink #1B1E22;
@define-color hs_ink_muted #4E545B;
@define-color hs_ink_faint #7A8086;
@define-color hs_rule #D3CCBD;
@define-color hs_rule_strong #736D62;
@define-color hs_signal #8F4B00;
@define-color hs_on_signal #FFFFFF;
@define-color hs_signal_well #F6DDB8;
@define-color hs_on_signal_well #3D2200;
@define-color hs_cue #1A5F88;
@define-color hs_on_cue #FFFFFF;
@define-color hs_cue_well #D3E7F3;
@define-color hs_on_cue_well #0B2E44;
@define-color hs_phosphor #256A3B;
@define-color hs_on_phosphor #FFFFFF;
@define-color hs_phosphor_well #D5EBD9;
@define-color hs_on_phosphor_well #0E2E17;
@define-color hs_alert #A8341C;
@define-color hs_on_alert #FFFFFF;
@define-color hs_alert_well #F7D7D0;
@define-color hs_on_alert_well #4A1209;
@define-color hs_inverse #1B1E22;
@define-color hs_on_inverse #F2EEE5;
@define-color hs_inverse_signal #F2A33A;
@define-color hs_scrim #000000;
@define-color hs_shadow #000000;
@define-color hs_focus #1A5F88;
@define-color hs_glow #8F4B00;
@define-color hs_signal_hover mix(@hs_signal, #000000, 0.12);
@define-color hs_signal_active mix(@hs_signal, @hs_base, 0.18);
@define-color hs_alert_hover mix(@hs_alert, #000000, 0.12);
@define-color theme_bg_color #F2EEE5;
@define-color theme_fg_color #1B1E22;
@define-color theme_base_color #F7F4EE;
@define-color theme_text_color #1B1E22;
@define-color theme_selected_bg_color #1A5F88;
@define-color theme_selected_fg_color #FFFFFF;
@define-color theme_tooltip_bg_color #FFFFFF;
@define-color theme_tooltip_fg_color #1B1E22;
@define-color theme_unfocused_bg_color #F2EEE5;
@define-color theme_unfocused_fg_color #4E545B;
@define-color theme_unfocused_base_color #F7F4EE;
@define-color theme_unfocused_text_color #4E545B;
@define-color theme_unfocused_selected_bg_color #D3E7F3;
@define-color theme_unfocused_selected_fg_color #0B2E44;
@define-color insensitive_bg_color #F7F4EE;
@define-color insensitive_fg_color #7A8086;
@define-color insensitive_base_color #F7F4EE;
@define-color borders #736D62;
@define-color unfocused_borders #D3CCBD;
@define-color warning_color #8F4B00;
@define-color error_color #A8341C;
@define-color success_color #256A3B;
